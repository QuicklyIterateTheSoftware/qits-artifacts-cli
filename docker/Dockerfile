# HOW THE BINARY IS BUILT.
#
# This repository ships no image — the artifact is `target/qits-publish`, a fully static musl binary
# that qits-artifacts serves as bytes and every composed release step downloads and execs. So the
# last stage here is a `FROM scratch` holding that one file, and what a build "produces" is an
# `--output type=local` of it. There is nothing to push and nothing to run.
#
# The shape is qits-ci-daemon's, deliberately and line for line where it can be: two `FROM scratch`
# export stages over one builder stage, the `ldd` assertion riding on the same RUN as the compile,
# and the CycloneDX document generated by the same mvnw invocation rather than a second one. Read
# that repository's docker/Dockerfile for the long argument behind each of those; what follows is
# only what differs here.
#
# --- WHAT DIFFERS: THE TOOLCHAIN IMAGE IS CONSUMED, NOT BUILT -------------------------------------
# qits-ci-daemon carries `docker/Dockerfile.musl-builder` because it AUTHORS that image:
# qits-bootstrap-cli reads that file and builds it by default target on a machine where no platform
# exists yet, which is why its last stage must stay the toolchain image. Nothing about this
# repository authors it. Copying the file here would give the platform two spellings of one
# toolchain that must never drift, and — worse — two pipelines pushing the same fixed tag, racing.
#
# So this file only NAMES the image, and the release pipeline beside it passes the address of the tag
# qits-ci-daemon's pipelines push on every QA fold and every release
# ($QITS_BUILD_REGISTRY/$QITS_IMAGE_REPOSITORY/graalvmce-musl-builder:jdk-25). That is a real
# dependency between two repositories and it is stated here rather than discovered: if the tag is
# absent, buildctl fails naming the image it could not resolve, which is the honest failure.
#
# THE DEFAULT NAMES THE LOCAL HAND-BUILT TAG, so a developer who already has the toolchain image
# builds with one line and needs no platform:
#
#     docker build --target binary --output type=local,dest=out -f docker/Dockerfile .
#
ARG BUILDER_IMAGE=qits/graalvmce-musl-builder:jdk-25

# --- stage `build`: the musl native compile -------------------------------------------------------
# /qits-build, kept verbatim from the sibling so a log line from either build reads the same.
# USER root because the base image ends on 1001 and the checkout arrives owned by root.
FROM ${BUILDER_IMAGE} AS build
USER root
WORKDIR /qits-build

# `.dockerignore` is what keeps this cheap: without it the line drags in every target/ dir, and a
# stale one can shadow what this stage compiles.
COPY . .

# Where Maven Central is mirrored, when it is. CI passes the platform mirror's IN-NETWORK route
# ($QITS_MAVEN_PROXY_URL): a RUN executes in the builder's own network namespace on qits-net. EMPTY —
# the default, and every hand build — deactivates `.qits-maven-settings.xml`'s central-proxy profile
# and the resolve goes to Maven Central directly. No credential rides along: platform reads are
# anonymous.
ARG QITS_MAVEN_CENTRAL_URL=
ENV QITS_MAVEN_CENTRAL_URL=$QITS_MAVEN_CENTRAL_URL

# GRAALVM_HOME IS RESOLVED RATHER THAN ASSUMED. native-maven-plugin looks for a GraalVM at
# GRAALVM_HOME and then at JAVA_HOME, and the builder image's JAVA_HOME is the base image's business
# rather than this file's. Probing both and failing with one sentence when neither answers is three
# lines; debugging "native-image not found" from a release log is not.
#
# THE ldd ASSERTION RIDES ON THE SAME RUN because this is where the binary is, and it is `ldd` rather
# than `file` on purpose: GraalVM emits a position-independent static executable, so `file` says
# "static-pie linked" and never the literal "statically linked". A glibc-linked binary is useless
# here — it does not execute at all on an alpine-family image, and the step images this binary has to
# run in are alpine-family — so the check belongs in the build rather than after it.
#
# `makeBom` RIDES ON THE SAME INVOCATION rather than getting a second one: a second `./mvnw` would be
# a second layer on top of a native compile and a re-resolve of the same project to produce a
# document the first run already had the model for. It runs on EVERY build, QA fold included, so the
# QA build and the release build are byte-identical LLB and the release is a stack of cache hits —
# and so a document that fails to generate fails the cheap gate rather than a release.
#
# cyclonedx.skipNotDeployed=false is LOAD-BEARING, measured on qits-artifacts-service's first
# release: nothing here is deployed to a maven repository, and the plugin SKIPS deploy-skipping
# modules by default, with a green build and one INFO line. The `sbom` stage's COPY then fails on a
# file nothing wrote. The spelling matters too: a bare -DskipNotDeployed=false is silently ignored,
# and only the cyclonedx.-prefixed property reaches the plugin.
RUN set -eu; \
    if [ -x "${JAVA_HOME:-/nonexistent}/bin/native-image" ]; then \
      GRAALVM_HOME="$JAVA_HOME"; \
    elif command -v native-image >/dev/null 2>&1; then \
      GRAALVM_HOME="$(dirname "$(dirname "$(command -v native-image)")")"; \
    else \
      echo "this builder image carries no native-image; see docker/Dockerfile" >&2; exit 1; \
    fi; \
    export GRAALVM_HOME; \
    ./mvnw -B -ntp -s .qits-maven-settings.xml package -Dnative -DskipTests \
      org.cyclonedx:cyclonedx-maven-plugin:2.9.1:makeBom \
      -DoutputFormat=json -DoutputName=sbom -DschemaVersion=1.6 \
      -Dcyclonedx.skipNotDeployed=false; \
    ldd target/qits-publish 2>&1 | grep -qE "statically linked|not a dynamic executable"

# --- sbom -----------------------------------------------------------------------------------------
# The CycloneDX document, exported so the release step can PUT it to the platform's SBOM store. A
# stage rather than a file dug out of a container, and BEFORE the `binary` stage on purpose: the last
# stage is what a plain build produces, and that must stay the artifact. The release pipeline reaches
# this one with `--opt target=sbom --output type=local`, using build-args byte-identical to the
# binary export, so every layer above is a cache hit and the export costs seconds rather than a
# second native compile.
FROM scratch AS sbom
COPY --from=build /qits-build/target/sbom.json /sbom.json

# --- binary ---------------------------------------------------------------------------------------
# THE ARTIFACT, AND THE DEFAULT TARGET. A `FROM scratch` holding one file is how a build that
# produces bytes rather than an image says so: `--output type=local,dest=out` writes
# `out/qits-publish`. The path inside the stage has no directory component, so the export lands flat.
#
# THE EXPORT DIRECTORY IS NOT THE CHECKOUT, and that is not tidiness: the release pipeline runs a
# second build against the SAME context, and a build's own output landing in that context would
# change it — so the `COPY . .` above would hash differently and the second export would pay for a
# whole second native compile. `.dockerignore` excludes `out/` as the belt to that braces.
FROM scratch AS binary
COPY --from=build /qits-build/target/qits-publish /qits-publish
